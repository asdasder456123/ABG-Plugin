<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071017">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="‹     الإعدادات"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <include layout="@layout/item_setting_game"/>
        <include layout="@layout/item_setting_performance"/>
        <include layout="@layout/item_setting_control"/>

        <LinearLayout
            android:id="@+id/settingVideo"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="5dp"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_dark_card">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="▣"
                android:textColor="#FF6F00"
                android:textSize="20sp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="إعدادات الفيديو"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الدقة والجرافيكس"
                    android:textColor="#888888"
                    android:textSize="10sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="25dp"
                android:layout_height="35dp"
                android:gravity="center"
                android:text="›"
                android:textColor="#FFFFFF"
                android:textSize="25sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="5dp"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_dark_card">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="🔊"
                android:textSize="18sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:text="إعدادات الصوت\nمستويات الصوت والمؤثرات"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="25dp"
                android:layout_height="35dp"
                android:gravity="center"
                android:text="›"
                android:textColor="#FFFFFF"
                android:textSize="25sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="5dp"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_dark_card">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="♟"
                android:textColor="#FF6F00"
                android:textSize="20sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:text="إعدادات الحساب\nإدارة حساباتك"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="25dp"
                android:layout_height="35dp"
                android:gravity="center"
                android:text="›"
                android:textColor="#FFFFFF"
                android:textSize="25sp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
