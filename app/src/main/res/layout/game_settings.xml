<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="إعدادات اللعبة"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center_vertical"/>

        <EditText
            android:id="@+id/edtWorldName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:hint="اسم العالم"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:background="@drawable/bg_dark_card"
            android:padding="14dp"/>

        <Spinner
            android:id="@+id/spnGameMode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"/>

        <Spinner
            android:id="@+id/spnDifficulty"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"/>

        <Switch
            android:id="@+id/switchLoad"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="تحميل المقاطع مسبقاً"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnSaveGame"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#FF6F00"
            android:text="حفظ"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</ScrollView>
