<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#071017">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:text="‹     اختيار الحساب"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="حساب مايكروسوفت"
        android:textColor="#AAAAAA"
        android:textSize="12sp"/>

    <LinearLayout
        android:id="@+id/accountMicrosoft"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_dark_card">

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="▦"
            android:textColor="#FFB900"
            android:textSize="25sp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تسجيل الدخول بحساب مايكروسوفت"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تسجيل الدخول واللعب مع أصدقائك"
                android:textColor="#888888"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="25dp"
            android:layout_height="35dp"
            android:gravity="center"
            android:text="›"
            android:textColor="#AAAAAA"
            android:textSize="25sp"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="الحسابات المحلية"
        android:textColor="#AAAAAA"
        android:textSize="12sp"/>

    <LinearLayout
        android:id="@+id/accountOffline"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_dark_card">

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="♙"
            android:textColor="#AAAAAA"
            android:textSize="24sp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حساب غير متصل بالإنترنت"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="للتشغيل دون اتصال بالإنترنت"
                android:textColor="#888888"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="25dp"
            android:layout_height="35dp"
            android:gravity="center"
            android:text="›"
            android:textColor="#AAAAAA"
            android:textSize="25sp"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="الحسابات المحفوظة"
        android:textColor="#AAAAAA"
        android:textSize="12sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_dark_card">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="🧑"
            android:textSize="20sp"
            android:background="#3A2B22"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ABGMC Player"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Microsoft Account"
                android:textColor="#888888"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="♲"
            android:textColor="#FF5252"
            android:textSize="18sp"/>

        <TextView
            android:layout_width="20dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#AAAAAA"
            android:textSize="20sp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnAddAccount"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="0dp"
        android:text="إضافة حساب جديد"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#FF6F00"/>

</LinearLayout>
